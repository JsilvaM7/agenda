// Agenda - Schema do Banco de Dados
// SQLite embutido — sem servidor externo, sem configuração

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  password         String
  name             String
  phone            String?
  pushSubscription String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  business         Business?
}

model Business {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  category    String?
  phone       String?
  address     String?
  active      Boolean    @default(true)
  suspended   Boolean    @default(false)
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeSlots   TimeSlot[]
  bookings    Booking[]
  invoices    Invoice[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TimeSlot {
  id         String    @id @default(cuid())
  dayOfWeek  Int
  startTime  String
  endTime    String
  duration   Int       @default(30)
  active     Boolean   @default(true)
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookings   Booking[]
  createdAt  DateTime  @default(now())
}

model Booking {
  id           String    @id @default(cuid())
  date         DateTime
  clientName   String?
  clientPhone  String?
  message      String?
  status       String    @default("CONFIRMED") // PENDING | CONFIRMED | CANCELLED
  reminderSent Boolean   @default(false)
  invoiced     Boolean   @default(false)
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  timeSlotId   String
  timeSlot     TimeSlot  @relation(fields: [timeSlotId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Invoice {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  bookingCount Int
  amountCents  Int
  status       String   @default("PENDING") // PENDING | PAID | OVERDUE
  paidAt       DateTime?
  dueDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, month, year])
}
