# =============================================
# AGENDA — Variáveis de Ambiente
# =============================================

# Banco de Dados SQLite (embutido, sem servidor)
# O arquivo agenda.db será criado automaticamente na pasta do projeto
DATABASE_URL="file:./agenda.db"

# NextAuth (gere uma chave segura: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="TROQUE_POR_UMA_CHAVE_SEGURA"
NEXTAUTH_URL="http://localhost:3000"

# Push Notifications (100% próprio, sem Firebase)
# Geradas com: node scripts/generate-vapid-keys.js
VAPID_PUBLIC_KEY="SUA_CHAVE_PUBLICA_VAPID"
VAPID_PRIVATE_KEY="SUA_CHAVE_PRIVADA_VAPID"
VAPID_EMAIL="admin@agenda-e-dolphin.com"

# Admin (você)
ADMIN_EMAIL="admin@agenda.com"
ADMIN_PASSWORD="TROQUE_POR_SENHA_SEGURA"

# URL pública do site
NEXT_PUBLIC_BASE_URL="https://agenda-e-dolphin.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="SUA_CHAVE_PUBLICA_VAPID"
